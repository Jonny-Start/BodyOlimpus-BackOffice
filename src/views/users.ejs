<%- include("./hooks/notifications"); -%>

<%- include('./layout/nav.ejs') %>

<main class="container-resolution internal_view">
  <%- include("./hooks/content_title", {title: 'Usuarios' }); -%>

  <section id="KPIs">
    <div class="kpi-item">
      <h3>Usuarios Activos</h3>
      <p id="activeUsers">102</p>
    </div>
    <div class="kpi-item">
      <h3>Usuarios Inactivos</h3>
      <p id="inactiveUsers">24</p>
    </div>
    <div class="kpi-item">
      <h3>Usuarios sin valoración</h3>
      <p id="pendingUsers">0</p>
    </div>
  </section>

  <header class="users-header">
    <div class="users-filters">
      <div class="contentInputs light md" style="margin: 0;" id="content_inputs_search">
        <input type="text" name="name" id="name" autocomplete="off" placeholder="N°" required>
        <ion-icon name="search"></ion-icon>
      </div>
      <button type="button" id="findUser" class="btn-primary">Buscar</button>
    </div>
    <div class="content_buttons">
      <!-- <button class="btn-secondary" id="btn-export" style="width: 2em;">Exportar a Excel</button>
      <button class="btn-secondary" id="btn-print" style="width: 3em;">Imprimir</button> -->
      <button class="btn-secondary" id="btn-more-filters" style="width: 10em;">Mas filtros</button>
      <button class="btn-primary" id="btn-add" style="width: 7em;">Agregar +</button>
    </div>
  </header>

  <section class="users-table">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Nombre</th>
          <th>N° Identificación</th>
          <th>Estado</th>
          <th>Acción</th>
        </tr>
      </thead>
      <tbody>
        <!-- Aquí se inyectan dinámicamente las resoluciones -->
        <tr>
          <td>1</td>
          <td>Jonny Alejandro Cano Acosta</td>
          <td>CC 1006844604</td>
          <td class="active-state">Activa</td>
          <td>
            <button class="btn-view">
              <ion-icon name="eye-regular"></ion-icon>
            </button>
            <button class="btn-edit">
              <ion-icon name="edit"></ion-icon>
            </button>
            <button class="btn-delete">
              <ion-icon name="trash"></ion-icon>
            </button>
            <button class="btn-mail">
              <ion-icon name="mail-outline"></ion-icon>
            </button>
            <button class="btn-whatsapp">
              <ion-icon name="whatsapp"></ion-icon>
            </button>
            <button class="btn-clipboard">
              <ion-icon name="clipboard"></ion-icon>
            </button>
            <button class="btn-paid">
              <ion-icon name="paid"></ion-icon>
            </button>
          </td>
        </tr>
        <!-- Más filas -->
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4" id="totalUsersPaginator">Total de usuarios: 1</td>
          <td id="paginator">
            <div class="paginator">
              <button class="btn-paginator" id="prevPage">
                <ion-icon name="chevron-left-solid"></ion-icon>
              </button>
              <span class="page-info">1 de 1</span>
              <button class="btn-paginator" id="nextPage" disabled>
                <ion-icon name="chevron-right-solid"></ion-icon>
              </button>
            </div>
          </td>
        </tr>
      </tfoot>
      </tbody>

    </table>
  </section>

  <%- include("./hooks/popup_users"); %>

</main>