<%- include("./hooks/notifications"); -%>

<%- include('./layout/nav.ejs') %>

<% let buttonsHTML = `<div id="content_buttons" style="width: -webkit-fill-available; text-align: end; margin-right: 5px;">`; %>
<% if (environment !== 'basic') { %>
<% buttonsHTML += `
        <button type="button" onclick="window.location.href='/company'" title="Datos básicos" style="width: 16em;">
          <p class="labelTaps">Datos básicos</p>
          <ion-icon name="building-regular-full" style="float: right;"></ion-icon>
        </button>
    `; %>
<% } %>
<% if (environment !== 'legal') { %>
<% buttonsHTML += `
        <button type="button" onclick="window.location.href='/company/legal'" title="Datos legales" style="width: 16em;">
            <p class="labelTaps">Datos legales</p>
            <ion-icon name="settings-legal" style="float: right;"></ion-icon>
        </button>
    `; %>
<% } %>
<% if (environment !== 'advanced') { %>
<% buttonsHTML += `
        <button type="button" onclick="window.location.href='/company/advanced'" title="Datos avanzados" style="width: 16em;">
          <p class="labelTaps">Datos avanzados</p>
          <ion-icon name="advance-panel" style="float: right;"></ion-icon>
        </button>
    `; %>
<% } %>
<% if (environment !== 'plans') { %>
<% buttonsHTML += `
        <button type="button" onclick="window.location.href='/company/plans'" title="Planes de suscripciones" style="width: 16em;">
          <p class="labelTaps">Planes</p>
          <ion-icon name="store" style="float: right;"></ion-icon>
        </button>
    `; %>
<% } %>
<% buttonsHTML += `</div>` %>


<% if (environment == 'basic') { %>

  <%- include("./companyParts/vew_basic.ejs", {buttonsHTML}); %>

<% } else if (environment == 'legal') { %>

  <%- include("./companyParts/view_legal.ejs", {buttonsHTML}); %>

<% } else if (environment == 'advanced') { %>

  <%- include("./companyParts/view_advanced.ejs", {buttonsHTML}); %>

<% } else if (environment == 'plans') { %>

  <%- include("./companyParts/plans.ejs", {buttonsHTML}); %>

<% } %>


<script>
  window.API_BASE_URL = "<%= API_BASE_URL %>";
  window.USER_TOKEN = "<%= token %>";
</script>
<script src="/public/js/global.js?v=1.1"></script>
<script src="/public/js/http.js?v=1.2"></script>