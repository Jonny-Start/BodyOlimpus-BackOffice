<%- include("./hooks/notifications"); -%>

<%- include('./layout/nav.ejs') %>

<% let buttonsHTML = `<div id="content_buttons" style="width: -webkit-fill-available; text-align: end; margin-right: 5px;">`; %>
<% if (environment !== 'basic') { %>
<% buttonsHTML += `
        <button type="button" onclick="window.location.href='/company'" title="Datos básicos">
            <ion-icon name="fitness-center"></ion-icon>
        </button>
    `; %>
<% } %>
<% if (environment !== 'legal') { %>
<% buttonsHTML += `
        <button type="button" onclick="window.location.href='/company/legal'" title="Datos legales">
            <ion-icon name="settings-legal"></ion-icon>
        </button>
    `; %>
<% } %>
<% if (environment !== 'advanced') { %>
<% buttonsHTML += `
        <button type="button" onclick="window.location.href='/company/advanced'" title="Datos avanzados">
            <ion-icon name="advance-panel"></ion-icon>
        </button>
    `; %>
<% } %>
<% buttonsHTML += `</div>` %>

<main class="internal_view">
  <%- include("./hooks/content_title", {title: 'GYM', child: buttonsHTML}); -%>
  <form action="/company" method="post" enctype="multipart/form-data" id="formCompanyBasic">
    <section id="inf_basic_img">
      <div class="content_form">
        <div class="contentInputs light md">
          <label for="name">Nombre</label>
          <input type="text" name="name" id="name" autocomplete="off" placeholder="Nombre Empresa/GYM" required>
          <ion-icon name="mail-outline"></ion-icon>
        </div>
        <div class="contentInputAndButton">
          <div class="contentInputs light md">
            <label for="name">Ubicación</label>
            <input type="text" name="name" id="name" autocomplete="on" placeholder="Nombre Empresa/GYM" required>
            <ion-icon name="mail-outline"></ion-icon>
          </div>
          <button type="button" class="btn">
            <ion-icon name="location-outline" class="iconLocation"></ion-icon>
          </button>
        </div>
        <div class="contentInputs contentSelect light md">
          <label for="name">Estado</label>
          <select name="status" id="status">
            <option value="1">Activo</option>
            <option value="0">Inactivo</option>
          </select>
        </div>
      </div>
      <div class="file-upload">
        <input type="hidden" name="currentImgFile" id="currentImgFile" value="">
        <input type="file" id="fileInput_plan" name="imgFile" class="file-input" accept="image/png, image/jpeg" onchange="previewImage(event)" required>
        <label for="fileInput_plan" id="contentLetter_plan" class="file-label">
          <img src="/public/img/documento.svg" alt="">
          <p>
            Cargue o arrastre el plano de distribución desde
            <br />
            su computadora o haga clic para subirlo.
            <br />
            Formato JPG o PNG. Máx 200 MB.
            <br />
            Tamaño máximo permitido (1200px X 630px).
          </p>
        </label>
      </div>
    </section>
    <div class="row">
      <div class="contentInputs light md">
        <label for="facebook">Facebook</label>
        <input type="text" name="facebook" id="facebook" autocomplete="facebook" placeholder="www.sitio.com/cuenta" required>
        <ion-icon name="mail-outline"></ion-icon>
      </div>
      <div class="contentInputs light md">
        <label for="youtube">Youtube</label>
        <input type="text" name="youtube" id="youtube" autocomplete="youtube" placeholder="www.sitio.com/cuenta" required>
        <ion-icon name="mail-outline"></ion-icon>
      </div>
      <div class="contentInputs light md">
        <label for="instagram">Instagram</label>
        <input type="text" name="instagram" id="instagram" autocomplete="instagram" placeholder="www.sitio.com/cuenta" required>
        <ion-icon name="mail-outline"></ion-icon>
      </div>
    </div>
    <div class="row">
      <div class="contentInputs light md">
        <label for="tiktok">TikTok</label>
        <input type="text" name="tiktok" id="tiktok" autocomplete="tiktok" placeholder="www.sitio.com/cuenta" required>
        <ion-icon name="mail-outline"></ion-icon>
      </div>
      <div class="contentInputs light md">
        <label for="x">X</label>
        <input type="text" name="x" id="x" autocomplete="x" placeholder="www.sitio.com/cuenta" required>
        <ion-icon name="mail-outline"></ion-icon>
      </div>
      <div class="contentInputs light md">
        <label for="whatsapp">Whatsapp</label>
        <input type="number" name="whatsapp" id="whatsapp" autocomplete="whatsapp" placeholder="319*******" required>
        <ion-icon name="mail-outline"></ion-icon>
      </div>
    </div>
    <button type="submit" class="btn btn-primary right">Guardar</button>
  </form>
  <%- include("./hooks/company/paymentMethods"); -%>
  <%- include("./hooks/company/gymAvailability"); -%>
  <%- include("./hooks/company/subscriptionPlans"); -%>
  <%- include("./hooks/company/accountInformation"); -%>

  <h2>Previsualización de factura</h2>


</main>

<script src="/public/js/company.js" type="text/javascript"></script>