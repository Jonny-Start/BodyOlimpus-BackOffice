<!DOCTYPE html>
<html>

<head>
  <title>Factura de Inscripción</title>
  <style>
    body {
      font-family: sans-serif;
      padding: 40px;
    }

    .factura-container {
      max-width: 600px;
      margin: auto;
      border: 1px solid #ccc;
      padding: 20px;
    }

    .preview-badge {
      background: #fff3cd;
      color: #856404;
      border: 1px solid #ffc107;
      border-radius: 4px;
      padding: 6px 12px;
      text-align: center;
      font-size: 12px;
      margin-bottom: 15px;
    }

    @media print {
      body {
        margin: 0;
        padding: 0;
      }

      .preview-badge {
        display: none;
      }
    }
  </style>
</head>

<body>
  <div class="factura-container">
    <% if (factura.isPreview) { %>
      <div class="preview-badge">
        📋 Vista previa de ejemplo — Los datos del cliente se completarán al generar una factura real.
      </div>
    <% } %>

    <div style="text-align: center; margin-bottom: 20px;">
      <% if (factura.logo) { %>
        <img src="<%= factura.logo %>" style="max-height: 80px; margin-bottom: 10px;" />
      <% } else { %>
        <div style="height: 80px; display: flex; align-items: center; justify-content: center; background: #eee; margin-bottom: 10px;">
          <span>Sin Logo</span>
        </div>
      <% } %>
      <h2 style="margin: 0;"><%= factura.nombreGym || "Factura de Inscripción" %></h2>
      <% if (factura.nitGym) { %>
        <p style="margin: 5px 0 15px 0; color: #555;">NIT: <%= factura.nitGym %></p>
      <% } %>
      <h3 style="margin-top: 15px;">Factura de Inscripción</h3>
    </div>

    <p><strong>Cliente:</strong> <%= factura.cliente %></p>
    <p><strong>Documento:</strong> <%= factura.documento %></p>
    <p><strong>Fecha:</strong> <%= factura.fecha %></p>

    <hr>

    <p><strong>Plan:</strong> <%= factura.plan %></p>
    <p><strong>Duración:</strong> <%= factura.duracion %></p>
    <p><strong>Método de Pago:</strong> <%= factura.metodoPago %></p>

    <hr>

    <p><strong>Total:</strong> $<%= factura.total.toLocaleString('es-CO') %></p>

    <p style="text-align: center; margin-top: 30px;">¡Gracias por tu inscripción!</p>
  </div>
</body>

</html>