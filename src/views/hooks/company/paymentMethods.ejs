<h2>
  Metodos de pago <ion-icon name="exclamation"></ion-icon>
</h2>
<section id="paymentMethods">

  <form action="#" method="post" enctype="multipart/form-data" id="formPaymentMethod">
    <article class="row wrap">

      <div class="contentCheck md flex paymentMethod">
        <input type="checkbox" name="cash" id="cash" value="cash">
        <label for="cash">Efectivo</label>
      </div>
      <div class="contentCheck md flex paymentMethod">
        <input type="checkbox" name="Nequi" id="Nequi" value="Nequi">
        <label for="Nequi">Nequi</label>
      </div>
      <div class="contentCheck md flex paymentMethod">
        <input type="checkbox" name="Nequi" id="Nequi" value="Nequi">
        <label for="Nequi">Nequi</label>
      </div>
      <div class="contentCheck md flex paymentMethod">
        <input type="checkbox" name="Bank_Transfer" id="Bank_Transfer" value="Bank_Transfer">
        <label for="Bank_Transfer">Transferencia <br /> Bancaria</label>
      </div>
      <div class="contentCheck md flex paymentMethod">
        <input type="checkbox" name="Payment_link" id="Payment_link" value="Payment_link">
        <label for="Payment_link">Link de pago</label>
      </div>
      <div class="contentCheck md flex paymentMethod">
        <input type="checkbox" name="Mercado_pago" id="Mercado_pago" value="Mercado_pago">
        <label for="Mercado_pago">Mercado pago</label>
      </div>
      <div class="contentCheck md flex paymentMethod">
        <input type="checkbox" name="ADDI" id="ADDI" value="ADDI">
        <label for="ADDI">ADDI</label>
      </div>
      <div class="contentCheck md flex paymentMethod">
        <input type="checkbox" name="PSE" id="PSE" value="PSE">
        <label for="PSE">PSE</label>
      </div>
      <div class="contentCheck md flex paymentMethod">
        <input type="checkbox" name="WOMPI" id="WOMPI" value="WOMPI">
        <label for="WOMPI">WOMPI</label>
      </div>
    </article>

    <button class="btn btn-primary right" id="addPaymentMethod">Guardar</button>
  </form>
</section>