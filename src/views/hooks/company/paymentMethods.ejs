<%
  /**
   * Construye un Set con los payment_method_id que la empresa ya tiene registrados
   * y un mapa de payment_method_id → company_payment_method_id para poder hacer PUT/DELETE
   */
  const companyMethodsMap = {};
  (options.companyPaymentMethods || []).forEach(function(cpm) {
    companyMethodsMap[cpm.payment_method_id] = cpm.company_payment_method_id;
  });
%>

<h2>
  Métodos de pago <ion-icon name="card-outline"></ion-icon>
</h2>
<section id="paymentMethods">
  <article class="row wrap" id="paymentMethodsList">

    <% if (options.paymentMethods && options.paymentMethods.length > 0) { %>
      <% options.paymentMethods.forEach(function(method) { %>
        <%
          const isChecked    = companyMethodsMap.hasOwnProperty(method.payment_method_id);
          const cpmId        = isChecked ? companyMethodsMap[method.payment_method_id] : '';
          const checkboxId   = 'pm_' + method.payment_method_id;
        %>
        <div class="contentCheck md flex paymentMethod">
          <input
            type="checkbox"
            id="<%= checkboxId %>"
            name="payment_method_<%= method.payment_method_id %>"
            value="<%= method.payment_method_id %>"
            data-payment-method-id="<%= method.payment_method_id %>"
            data-company-payment-method-id="<%= cpmId %>"
            data-company-id="<%= dataCompany.company_id %>"
            <%= isChecked ? 'checked' : '' %>
            onchange="togglePaymentMethod(this)"
          >
          <label for="<%= checkboxId %>">
            <% if (method.icon) { %>
              <ion-icon name="<%= method.icon %>"></ion-icon>
            <% } %>
            <%= method.name %>
          </label>
        </div>
      <% }); %>
    <% } else { %>
      <p class="empty-state">No hay métodos de pago disponibles.</p>
    <% } %>

  </article>
</section>