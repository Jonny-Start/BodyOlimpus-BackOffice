<%
  /**
   * Mapea los horarios existentes por day_of_week para acceso rápido
   * { 1: { is_open: true, open_time: "06:00", close_time: "21:00" }, ... }
   */
  const schedulesMap = {};
  (options.companySchedules || []).forEach(function(s) {
    schedulesMap[s.day_of_week] = s;
  });

  const days = [
    { num: 1, short: 'L', name: 'Lunes',     id: 'monday'    },
    { num: 2, short: 'M', name: 'Martes',    id: 'tuesday'   },
    { num: 3, short: 'M', name: 'Miércoles', id: 'wednesday' },
    { num: 4, short: 'J', name: 'Jueves',    id: 'thursday'  },
    { num: 5, short: 'V', name: 'Viernes',   id: 'friday'    },
    { num: 6, short: 'S', name: 'Sábado',    id: 'saturday'  },
    { num: 7, short: 'D', name: 'Domingo',   id: 'sunday'    },
  ];
%>

<h2>
  Disponibilidad
</h2>
<section id="gymAvailability">
  <input type="hidden" id="schedule_company_id" value="<%= dataCompany.company_id %>">

  <article class="row wrap" style="gap: 3em;">
    <h3>DIAS:</h3>
    <% days.forEach(function(day) { %>
      <%
        const schedule = schedulesMap[day.num];
        const isOpen = schedule ? schedule.is_open : false;
      %>
      <div class="contentCheck md flex-col-center">
        <label for="day_<%= day.num %>"><%= day.short %></label>
        <input
          type="checkbox"
          name="day_<%= day.num %>"
          id="day_<%= day.num %>"
          value="<%= day.num %>"
          <%= isOpen ? 'checked' : '' %>
          onchange="toggleDaySchedule(<%= day.num %>)"
        >
      </div>
    <% }); %>
  </article>

  <h3>HORARIO:</h3>
  <article class="row wrap" id="schedule_availability">
    <% days.forEach(function(day) { %>
      <%
        const schedule = schedulesMap[day.num];
        const isOpen = schedule ? schedule.is_open : false;
        const openTime = schedule && schedule.open_time ? schedule.open_time.substring(0, 5) : '';
        const closeTime = schedule && schedule.close_time ? schedule.close_time.substring(0, 5) : '';
      %>
      <div id="<%= day.id %>_time" class="contentTime<%= isOpen ? ' active' : '' %>">
        <label><%= day.name %></label>
        <div class="contentInputs light md">
          <label for="open_time_<%= day.num %>">Desde</label>
          <input
            type="time"
            name="open_time_<%= day.num %>"
            id="open_time_<%= day.num %>"
            value="<%= openTime %>"
          >
        </div>
        <div class="contentInputs light md">
          <label for="close_time_<%= day.num %>">Hasta</label>
          <input
            type="time"
            name="close_time_<%= day.num %>"
            id="close_time_<%= day.num %>"
            value="<%= closeTime %>"
          >
        </div>
      </div>
    <% }); %>
  </article>

  <button class="btn btn-primary right" id="saveSchedules" type="button" onclick="saveSchedules()">Guardar</button>
</section>