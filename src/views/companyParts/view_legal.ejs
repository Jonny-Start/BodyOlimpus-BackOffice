<main class="container-resolution internal_view">
  <%- include("./../hooks/content_title", {title: 'GYM', child: buttonsHTML}); -%>

  <header class="resolutions-header">
    <h2>Resoluciones DIAN</h2>
    <div class="resolutions-filters">
      <div class="contentInputs light md" style="margin: 0;">
        <input type="text" id="searchResolution" autocomplete="off" placeholder="Buscar por N° resolución">
        <ion-icon name="search"></ion-icon>
      </div>
      <div class="contentInputs contentSelect light md" style="margin: 0;">
        <select id="filterStatus">
          <option value="all">Todos</option>
          <option value="1">Activo</option>
          <option value="0">Inactivo</option>
        </select>
      </div>
      <button class="btn-primary" id="btn-add-resolution" style="width: 16em;">Agregar +</button>
    </div>
  </header>

  <section class="resolutions-table">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>N° Resolución</th>
          <th>Fecha Resolución</th>
          <th>Fecha Vencimiento</th>
          <th>Estado</th>
          <th>Acción</th>
        </tr>
      </thead>
      <tbody id="resolutionsTableBody">
        <!-- Se renderiza dinámicamente desde JS -->
      </tbody>
    </table>

    <div class="empty-state" id="emptyState" style="display: none;">
      <ion-icon name="document-text-outline" style="font-size: 3rem; color: #ccc;"></ion-icon>
      <p>No hay resoluciones registradas</p>
      <small>Haz clic en "Agregar +" para crear una nueva resolución</small>
    </div>
  </section>

  <!-- Modal Agregar/Editar Resolución -->
  <div class="modal-overlay" id="modalResolution">
    <div class="modal-content">
      <h3 id="modalTitle">Agregar Resolución DIAN</h3>
      <form id="formResolution">
        <input type="hidden" id="resolutionId" value="">

        <div class="contentInputs light md">
          <label for="resolutionNumber">N° Resolución</label>
          <input type="text" name="resolutionNumber" id="resolutionNumber" autocomplete="off" placeholder="Ej: 187640000" required>
          <ion-icon name="document-text-outline"></ion-icon>
        </div>

        <div class="contentInputs light md">
          <label for="resolutionDate">Fecha Resolución</label>
          <input type="date" name="resolutionDate" id="resolutionDate" autocomplete="off">
          <ion-icon name="calendar-outline"></ion-icon>
        </div>

        <div class="contentInputs light md">
          <label for="expirationDate">Fecha Vencimiento</label>
          <input type="date" name="expirationDate" id="expirationDate" autocomplete="off" required>
          <ion-icon name="calendar-outline"></ion-icon>
        </div>

        <div class="contentInputs contentSelect light md">
          <label for="resolutionStatus">Estado</label>
          <select name="resolutionStatus" id="resolutionStatus">
            <option value="1">Activa</option>
            <option value="0">Inactiva</option>
          </select>
        </div>

        <div class="actions-form">
          <button type="submit" class="btn-primary" id="btnSaveResolution">Guardar</button>
          <button type="button" id="btnCancelResolution" class="btn-secondary">Cancelar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Confirmar Eliminación -->
  <div class="modal-overlay" id="modalDeleteConfirm">
    <div class="modal-content" style="max-width: 450px; text-align: center;">
      <h3>¿Eliminar resolución?</h3>
      <p style="margin: 1.5em 0; color: #666;">Esta acción no se puede deshacer. La resolución será eliminada permanentemente.</p>
      <input type="hidden" id="deleteResolutionId" value="">
      <div class="actions-form" style="justify-content: center;">
        <button type="button" class="btn-delete-confirm" id="btnConfirmDelete">Eliminar</button>
        <button type="button" class="btn-secondary" id="btnCancelDelete">Cancelar</button>
      </div>
    </div>
  </div>

</main>

<script>
  // Pasar el company_id al JS para las peticiones API
  window.RESOLUTION_COMPANY_ID = '<%= dataCompany.company_id %>';
</script>
<script src="/public/js/company.js?v=1.1" type="text/javascript"></script>