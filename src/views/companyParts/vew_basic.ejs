<main class="internal_view">
  <%- include("./../hooks/content_title", {title: 'GYM', child: buttonsHTML}); -%>
  <form action="/company" method="post" enctype="multipart/form-data" id="formCompanyBasic">
    <input type="hidden" name="company_id" id="company_id" value="<%= dataCompany.company_id %>">
    <section id="inf_basic_img">
      <div class="content_form">
        <div class="contentInputs light md">
          <label for="name">Nombre</label>
          <input type="text" name="name" id="name" autocomplete="off" placeholder="Nombre Empresa/GYM" value="<%= dataCompany.name %>" required>
          <ion-icon name="mail-outline"></ion-icon>
        </div>
        <div class="contentInputAndButton">
          <div class="contentInputs light md">
            <label for="direccion">Ubicación</label>
            <input type="text" name="address" id="address" autocomplete="on" placeholder="Dirección exacta" readonly onclick="openPopupMap()" value="<%= dataCompany.address %>">
            <ion-icon name="location-outline"></ion-icon>
          </div>
          <button type="button" class="btn" onclick="openPopupMap()">
            <ion-icon name="location-outline" class="iconLocation"></ion-icon>
          </button>
        </div>
        <input type="hidden" name="latitude" id="latitude" value="<%= dataCompany.latitude %>">
        <input type="hidden" name="longitude" id="longitude" value="<%= dataCompany.longitude %>">

        <div class="contentInputs contentSelect light md">
          <label for="name">Estado</label>
          <select name="status" id="status">
            <option value="1" <%= dataCompany.active == 1 ? 'selected' : '' %>>Activo</option>
            <option value="0" <%= dataCompany.active == 0 ? 'selected' : '' %>>Inactivo</option>
          </select>
        </div>
      </div>
      <div class="file-upload">
        <input type="hidden" name="currentImgFile" id="currentImgFile" value="<%= dataCompany.imgFile || '' %>">
        <input type="file" id="fileInput_plan" name="imgFile" class="file-input" accept="image/png, image/jpeg" onchange="previewImage(event)" <%= dataCompany.img_path ? '' : 'required' %>>
        <label for="fileInput_plan" id="contentLetter_plan" class="file-label" data-img-url="<%= dataCompany.img_path ? API_BASE_URL + "/" + dataCompany.img_path : '' %>">
          <% if (dataCompany.imgUrl) { %>
            <img src="<%= dataCompany.imgUrl %>" alt="Plano actual" style="display:none;">
          <% } else { %>
            <img src="/public/img/documento.svg" alt="">
          <% } %>
          <p>
            Cargue o arrastre el plano de distribución desde
            <br />
            su computadora o haga clic para subirlo.
            <br />
            Formato JPG o PNG. Máx 200 MB.
            <br />
            Tamaño máximo permitido (1200px X 630px).
          </p>
        </label>
      </div>
    </section>
    <% options.socialNetworks.forEach(function(network, index) { %>
      <% if (index % 3 === 0) { %>
        <div class="row">
      <% } %>
        <!-- Aquí va el contenido de cada opción de red social -->
        <div class="contentInputs light md">
          <label for="network_<%= network.social_networks_id %>"><%= network.name %></label>
          <input type="text" name="network_<%= network.name %>_<%= network.social_networks_id %>" id="network_<%= network.social_networks_id %>" autocomplete="<%= network.name %>" placeholder="<%= network.place_holder %>" pattern="<%= network.validation_pattern %>">
          <ion-icon name="mail-outline"></ion-icon>
        </div>
      <% if ((index + 1) % 3 === 0 || index === options.socialNetworks.length - 1) { %>
        </div>
      <% } %>
    <% }); %>

    <button type="submit" class="btn btn-primary right">Guardar</button>
  </form>
  <%- include("./../hooks/company/paymentMethods"); -%>
  <%- include("./../hooks/company/gymAvailability"); -%>
  <%- include("./../hooks/company/subscriptionPlans"); -%>
  <%- include("./../hooks/company/accountInformation"); -%>

  <h2>Previsualización de factura</h2>
  <div>
    <button onclick="document.getElementById('invoiceIframe').contentWindow.print()">Imprimir Factura</button>
    <iframe id="invoiceIframe" src="/invoice/registration" style="width:100%; height:600px; border:1px solid #ccc;"></iframe>
  </div>

</main>

<div id="popupMap">
  <div class="map-container">
    <button class="close-btn" onclick="closePopupMap()">✖</button>
    <h3>Select Location</h3>
    <!-- Asegúrate de que este elemento no tenga atributos que puedan interferir -->
    <input id="addressSearch" type="text" placeholder="Buscar dirección...">
    <div id="map"></div>
    <button class="btn btn-primary" onclick="confirmLocation()" style="width: 10em;">Confirmar</button>
  </div>
</div>

<script src="/public/js/company.js?v=1.1" type="text/javascript"></script>

<script>
// Precargar imagen si existe
window.addEventListener('DOMContentLoaded', function () {
  const label = document.getElementById('contentLetter_plan');
  const imgUrl = label.getAttribute('data-img-url');
  if (imgUrl) {
    label.style.backgroundImage = `url(${imgUrl})`;
    label.style.backgroundSize = 'cover';
    label.textContent = '';
  }
});
</script>

<script src="/public/js/configMaps.js?v=1.0"></script>

<!-- API de Google Maps con las bibliotecas necesarias -->
<script src="https://maps.googleapis.com/maps/api/js?key=<%= MAPS_API_KEY %>&libraries=places&callback=initMap" async defer></script>