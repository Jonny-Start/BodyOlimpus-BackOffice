<main class="container-resolution internal_view">
  <%- include("./../hooks/content_title", {title: 'GYM', child: buttonsHTML}); -%>

  <header class="resolutions-header">
    <h2>Planes de suscripcion</h2>
    <div class="resolutions-filters">
      <div class="contentInputs light md" style="margin: 0;">
        <input type="text" name="name" id="name" autocomplete="off" placeholder="Nombre del plan" required>
        <ion-icon name="search"></ion-icon>
      </div>
      <div class="contentInputs contentSelect light md" style="margin: 0;">
        <select name="status" id="status">
          <option value="1">Activo</option>
          <option value="0">Inactivo</option>
        </select>
      </div>
      <button class="btn-primary" id="btn-add" style="width: 16em;">Agregar +</button>
    </div>
  </header>

  <section class="resolutions-table">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Nombre plan</th>
          <th>Costo</th>
          <th>Users activos</th>
          <th>Estado</th>
          <th>Acción</th>
        </tr>
      </thead>
      <tbody>
        <!-- Aquí se inyectan dinámicamente las resoluciones -->
        <tr>
          <td>1</td>
          <td>Mensual</td>
          <td>$90.000</td>
          <td>150</td>
          <td class="active-state">Activa</td>
          <td>
            <button class="btn-view">
              <ion-icon name="eye-regular"></ion-icon>
            </button>
            <button class="btn-edit">
              <ion-icon name="edit"></ion-icon>
            </button>
            <button class="btn-delete">
              <ion-icon name="trash"></ion-icon>
            </button>
          </td>
        </tr>
        <!-- Más filas -->
      </tbody>
    </table>
  </section>

  <div class="modal-overlay" id="modalAdd">
    <div class="modal-content">
      <h3>Agregar Resolución DIAN</h3>
      <form id="formAddResolution">

        <div class="contentInputs light md">
          <label for="facebook">N° Resolución</label>
          <input type="text" name="facebook" id="facebook" autocomplete="facebook" placeholder="www.sitio.com/cuenta" required>
          <ion-icon name="mail-outline"></ion-icon>
        </div>

        <div class="contentInputs light md">
          <label for="facebook">Fecha Resolución</label>
          <input type="text" name="facebook" id="facebook" autocomplete="facebook" placeholder="www.sitio.com/cuenta" required>
          <ion-icon name="mail-outline"></ion-icon>
        </div>

        <div class="contentInputs light md">
          <label for="facebook">Fecha Vencimiento</label>
          <input type="date" name="facebook" id="facebook" autocomplete="facebook" placeholder="www.sitio.com/cuenta" required>
          <ion-icon name="mail-outline"></ion-icon>
        </div>

        <div class="contentInputs contentSelect light md">
          <label for="name">Estado</label>
          <select name="status" id="status">
            <option value="1">Activo</option>
            <option value="0">Inactivo</option>
          </select>
        </div>

        <label>Archivo PDF (máx 2MB)</label>
        <input type="file" name="document" accept="application/pdf" required />

        <div class="actions-form">
          <button type="submit" class="btn-primary">Guardar</button>
          <button type="button" id="cancelModal" class="btn-secondary">Cancelar</button>
        </div>
      </form>
    </div>
  </div>

</main>
<script>
  const modal = document.getElementById("modalAdd");
  const btnOpen = document.getElementById("btn-add");
  const btnCancel = document.getElementById("cancelModal");
  const form = document.getElementById("formAddResolution");

  btnOpen.addEventListener("click", () => {
    modal.style.display = "flex";
  });

  btnCancel.addEventListener("click", () => {
    modal.style.display = "none";
    form.reset();
  });

  // Validación archivo
  form.addEventListener("submit", (e) => {
    const archivo = form.documento.files[0];

    if (archivo) {
      const maxSizeMB = 2;
      const isPDF = archivo.type === "application/pdf";

      if (!isPDF) {
        alert("Solo se permiten archivos PDF.");
        e.preventDefault();
        return;
      }

      if (archivo.size > maxSizeMB * 1024 * 1024) {
        alert("El archivo no debe superar los 2 MB.");
        e.preventDefault();
        return;
      }
    } else {
      alert("Por favor adjunta el archivo de resolución.");
      e.preventDefault();
    }
  });
</script>