<%- include("./hooks/notifications"); -%>

<div class="shapeReset"></div>

<main id="contentResetPassword">
  <a href="/login"><i class="fa-solid fa-chevron-left"></i> volver</a>

  <h1>Recuperar contraseña</h1>
  <p>La contraseña debe tener al menos 8 caracteres, una mayúscula, una minúscula y un número</p>

  <form action="/resetPassword?token=<%= token %>" method="post">

    <div class="contentInputs contentPassword">
      <label for="newPassword">Nueva Contraseña</label>
      <input type="password" id="newPassword" name="newPassword" placeholder="clave secreta" autocomplete="off" required>
      <ion-icon name="lock-closed-outline"></ion-icon>
      <ion-icon name="eye-off-outline" id="eyeClose" class="hide" onclick="showPassword('newPassword')"></ion-icon>
      <ion-icon name="eye-outline" id="eyeOpen" onclick="showPassword('newPassword')"></ion-icon>
    </div>
    <div class="contentInputs contentPassword">
      <label for="confirm_password">Confirmar contraseña</label>
      <input type="password" id="confirm_password" name="confirm_password" placeholder="clave secreta" autocomplete="off" required>
      <ion-icon name="lock-closed-outline"></ion-icon>
      <ion-icon name="eye-off-outline" id="eyeCloseConfirm" class="hide" onclick="showPassword('confirm_password','Confirm')"></ion-icon>
      <ion-icon name="eye-outline" id="eyeOpenConfirm" onclick="showPassword('confirm_password','Confirm')"></ion-icon>
    </div>

    <button type="submit" class="btn-primary" disabled>Enviar</button>

  </form>

</main>

<div class="shapeReset"></div>



<script type="text/javascript">
  const newPassword = document.getElementById('newPassword');
  const confirmPassword = document.getElementById('confirm_password');
  const btnSubmit = document.querySelector('button[type="submit"]');

  newPassword.addEventListener('input', (e) => validatePassword(e));
  confirmPassword.addEventListener('input', (e) => validatePassword(e));

  function validatePassword(event) {
    let passwordRegex = /^(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}$/;
    if (
      (newPassword.value.length >= 6 && confirmPassword.value.length >= 6) &&
      passwordRegex.test(newPassword.value) &&
      newPassword.value === confirmPassword.value
    ) {
      btnSubmit.removeAttribute('disabled');
    } else {
      btnSubmit.setAttribute('disabled', true);
    }
  }

  function showPassword(idInput, prefix = '') {
    const password = document.getElementById(idInput);
    const eyeOpen = document.getElementById('eyeOpen' + prefix);
    const eyeClose = document.getElementById('eyeClose' + prefix);

    eyeOpen.classList.toggle('hide');
    eyeClose.classList.toggle('hide');
    eyeClose.classList.contains('hide') ? password.type = 'password' : password.type = 'text';
  }
</script>