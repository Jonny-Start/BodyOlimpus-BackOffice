<%- include("./hooks/notifications"); -%>

<main id="sectionCA">
  <section id="contentSteps">

    <h2>¡Estas a un paso de tener <br /> la mejor administración de tu gimnasio!</h2>

    <p>Completa estos sencillos <br /> pasos para crear tu cuenta en <br /> BO:</p>

    <ul class="steps">
      <li class="active">
        <div class="circle">1</div>
        <p>Ingresa tu nombre, apellido y correo</p>
      </li>
      <li class="active">
        <div class="circle">2</div>
        <p>Verifica tu cuenta</p>
      </li>
      <li class="active">
        <div class="circle">3</div>
        <p>Completa los datos basicos</p>
      </li>
    </ul>

    <h3><span class="primaryBlue">B</span>ody<span class="primaryBlue">O</span>limpus</h3>
  </section>
  <section id="register">
    <img src="/img/Logo_White-transparent.svg" alt="logo de BodyOlimupus">
    <h1>Hola <%= dataUser.name %>, completa tu registro</h1>

    <form action="/createAccount?token=<%= token %>" method="post">
      <div class="contentInputs">
        <label for="name_gym">Nombre del GYM</label>
        <input type="text" name="name_gym" id="name_gym" placeholder="Ingresa el nombre de tu gimnasio" required>
        <ion-icon name="dumbbell-solid"></ion-icon>
      </div>
      <div class="contentInputs contentPassword">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" placeholder="clave secreta" required>
        <ion-icon name="lock-closed-outline"></ion-icon>
        <ion-icon name="eye-off-outline" id="eyeClose" class="hide" onclick="showPassword('password')"></ion-icon>
        <ion-icon name="eye-outline" id="eyeOpen" onclick="showPassword('password')"></ion-icon>
      </div>
      <div class="contentInputs contentPassword">
        <label for="confirm_password">Confirmar contraseña</label>
        <input type="password" id="confirm_password" name="confirm_password" placeholder="clave secreta" required>
        <ion-icon name="lock-closed-outline"></ion-icon>
        <ion-icon name="eye-off-outline" id="eyeCloseConfirm" class="hide" onclick="showPassword('confirm_password','Confirm')"></ion-icon>
        <ion-icon name="eye-outline" id="eyeOpenConfirm" onclick="showPassword('confirm_password','Confirm')"></ion-icon>
      </div>

      <p class="contentDescriptionPass">La contraseña debe ser alfanumérica, debe contener minimo 8 caracteres, una letra ayúscula, un número y un carácter especial.</p>

      <button type="submit" class="btn-primary" id="buttonRequestCreateAccount" disabled>Terminar</button>
    </form>

  </section>

</main>

<script type="text/javascript">
  window.addEventListener('DOMContentLoaded', () => {
    const button = document.getElementById('buttonRequestCreateAccount');
    const inputs = document.querySelectorAll('input');
    inputs.forEach(input => {
      input.addEventListener('input', () => {
        if (inputs[0].value && inputs[1].value && inputs[2].value) {
          button.removeAttribute('disabled');
        } else {
          button.setAttribute('disabled', true);
        }
      });
    });
  });

  function showPassword(idInput, prefix = '') {
    const password = document.getElementById(idInput);
    const eyeOpen = document.getElementById('eyeOpen' + prefix);
    const eyeClose = document.getElementById('eyeClose' + prefix);

    eyeOpen.classList.toggle('hide');
    eyeClose.classList.toggle('hide');
    eyeClose.classList.contains('hide') ? password.type = 'password' : password.type = 'text';
  }
</script>