<%- include("./hooks/notifications"); -%>

<h1>Creación de cuenta</h1>

<form action="/createAccount?token=<%= token %>" method="post">

    <!-- <img src="/img/Logo_White-transparent.svg" alt="logo de BodyOlimupus"> -->

    <h1>Hola <%= dataUser.name %>, termina la creación de tu cuenta</h1>

    <div class="contentInputs">
        <label for="password">Contraseña</label>
        <input type="password" name="password" id="password" autocomplete="password" placeholder="Contraseña" required>
        <ion-icon name="mail-outline"></ion-icon>
    </div>
    <div class="contentInputs">
        <label for="confirm_password">Confirmar contraseña</label>
        <input type="password" name="confirm_password" id="confirm_password" autocomplete="confirm_password" placeholder="Confirma contraseña" required>
        <ion-icon name="mail-outline"></ion-icon>
    </div>
    <div class="contentInputs">
        <label for="name_gym">Nombre del GYM</label>
        <input type="text" name="name_gym" id="name_gym" autocomplete="name_gym" placeholder="Ingresa el nombre de tu gimnasio" required>
        <ion-icon name="mail-outline"></ion-icon>
    </div>

    <button type="submit" class="btn-primary">Enviar</button>
    <!-- <button type="submit" class="btn-primary">Cancelar Proceso</button> -->
</form>